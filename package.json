  "license": "MIT",
  "author": "respectbarristerk-tech (https://github.com/respectbarristerk-tech)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/respectbarristerk-tech/keiri-files-mcp.git"
  },
  "homepage": "https://github.com/respectbarristerk-tech/keiri-files-mcp#readme",
  "bugs": {
    "url": "https://github.com/respectbarristerk-tech/keiri-files-mcp/issues"
  },
  "type": "module",
